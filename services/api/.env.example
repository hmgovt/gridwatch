# Copy to .env for local development. Never commit real values.

PORT=8787
HOST=127.0.0.1

# Web origins allowed to call the API (comma separated). Include the native
# shells' origins once the app is wrapped with Capacitor.
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

DATA_DIR=./data

# Poll the grid data feeds from this process. Set to off where a separate
# scheduled job runs ingestion instead.
INGEST=on

# Set when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Web Push (VAPID). Generate with: pnpm --filter @gridwatch/api vapid:generate
# Keep the private key in a secret manager in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.org

# Operator token for publishing a rotation schedule by hand while no
# machine-readable feed exists. At least 32 random characters. Leave empty to
# disable the admin routes entirely.
ADMIN_TOKEN=
