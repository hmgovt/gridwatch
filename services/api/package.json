{
  "name": "@gridwatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "ingest:once": "node --disable-warning=ExperimentalWarning src/cli/ingest-once.ts",
    "vapid:generate": "node src/cli/generate-vapid.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@gridwatch/core": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.9",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/web-push": "3.6.4",
    "vitest": "5.0.2"
  }
}
